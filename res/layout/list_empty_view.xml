<com.android.messaging.ui.ListEmptyView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:layout_gravity="center">

    <ImageView
        android:id="@+id/empty_image_hint"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_gravity="center"
        android:background="@drawable/m3e_empty_tile"
        android:importantForAccessibility="no"
        android:padding="22dp"
        android:src="@drawable/ic_message"
        android:tint="@color/m3e_on_primary_container" />

    <TextView
        android:id="@+id/empty_text_hint"
        android:gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/google_sans_flex"
        android:textSize="@dimen/m3e_text_headline_small"
        android:textColor="@color/m3e_on_surface"
        android:textStyle="bold"
        android:text="@string/m3e_empty_title" />

    <TextView
        android:id="@+id/empty_subtext_hint"
        android:gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/google_sans_flex"
        android:textSize="@dimen/m3e_text_body_medium"
        android:textColor="@color/m3e_on_surface_variant"
        android:text="@string/m3e_empty_subtitle" />
</com.android.messaging.ui.ListEmptyView>
