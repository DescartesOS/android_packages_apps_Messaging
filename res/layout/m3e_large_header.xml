<!-- Expressive hero header: two tone headline, cookie emblem and a pill search bar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/large_header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="16dp"
    app:layout_collapseMode="parallax"
    app:layout_collapseParallaxMultiplier="0.4">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/m3e_header_margin"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="@dimen/m3e_page_margin"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/large_header_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/google_sans_flex"
                android:includeFontPadding="false"
                android:lineSpacingMultiplier="0.92"
                android:maxLines="2"
                android:text="@string/m3e_header_title"
                android:textColor="@color/m3e_on_surface"
                android:textSize="@dimen/m3e_header_title_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/large_header_accent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/google_sans_flex"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/m3e_header_accent"
                android:textColor="@color/m3e_primary"
                android:textSize="@dimen/m3e_header_title_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/large_header_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxLines="2"
                android:fontFamily="@font/google_sans_flex"
                android:text="@string/m3e_header_subtitle"
                android:textColor="@color/m3e_on_surface_variant"
                android:textSize="@dimen/m3e_text_body_large" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/large_header_emblem"
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:layout_marginStart="12dp">

            <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:rotation="-12"
                android:src="@drawable/m3e_hero_emblem" />

            <ImageButton
                android:id="@+id/large_header_add"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="bottom|end"
                android:background="@drawable/m3e_badge_button"
                android:contentDescription="@string/start_new_conversation"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_add_white"
                android:tint="@color/m3e_on_primary" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/large_header_search"
        android:layout_width="match_parent"
        android:layout_height="@dimen/m3e_search_pill_height"
        android:layout_marginStart="@dimen/m3e_page_margin"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="@dimen/m3e_page_margin"
        android:background="@drawable/m3e_search_pill"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="16dp"
        android:drawableTint="@color/m3e_primary"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:text="@string/m3e_search_hint"
        android:textColor="@color/m3e_on_surface_variant"
        android:textSize="@dimen/m3e_text_body_large"
        android:fontFamily="@font/google_sans_flex" />
</LinearLayout>
