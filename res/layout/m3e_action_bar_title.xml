<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/action_bar_emblem"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:importantForAccessibility="no"
        android:src="@drawable/m3e_nav_emblem" />

    <TextView
        android:id="@+id/action_bar_title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:fontFamily="@font/google_sans_flex"
        android:text="@string/app_name"
        android:textColor="@color/m3e_on_surface"
        android:textSize="@dimen/m3e_text_title_large"
        android:textStyle="bold" />
</LinearLayout>
